#!/bin/bash

# Backend for the Omarchy AppImages plugin: keeps ~/AppImage and the desktop
# launcher in sync, and owns the per-AppImage overrides.
#
#   appimages sync [--quiet]      Regenerate desktop entries (idempotent)
#   appimages list                Emit one TSV row per AppImage, for the panel
#   appimages dir                 Print the watched directory
#   appimages rename [id] [name]  Set a launcher name; empty name resets it
#   appimages hide [id] [on|off]  Keep an AppImage out of the launcher
#   appimages run <id>            Launch it, reporting a start that fails
#   appimages focus <id>          Focus its window if one is open
#   appimages delete <id>         Delete the AppImage file itself
#   appimages menu                Interactive front-end for the above
#
# Names, icons, categories and mime types come from the desktop entry embedded
# in the AppImage itself -- read out of the image with a parser, never by
# running the AppImage. Nothing from an image executes until the user launches
# it. Overrides live in appimages.json and survive both a re-sync and a new
# version of the AppImage.

set -euo pipefail

CONFIG="${APPIMAGE_CONFIG:-$HOME/.config/omarchy/appimages.json}"
DESKTOP_DIR="$HOME/.local/share/applications"
STATE_DIR="$HOME/.local/state/appimages"
PREFIX="appimage-"
GLYPH="󰏖"

# Bounds on what is read out of an image. An image is untrusted input: its
# desktop entry and icon are parsed under these caps and inside a sandbox.
MAX_ENTRY_BYTES=65536
MAX_ICON_BYTES=4194304
EXTRACT_SECONDS=30
HEADER_SECONDS=5
HEADER_MEMORY=$((128 * 1024 * 1024))

notify() { command -v omarchy-notification-send >/dev/null && omarchy-notification-send -g "$GLYPH" "$1" "${2:-}" || true; }

titleize() { printf '%s' "$1" | sed 's/[-_.]\+/ /g; s/\b\(.\)/\u\1/g'; }

# The id keys a launcher entry, a state directory and a config override, so it
# has to be stable for a given filename and distinct between filenames. Case
# and separators are kept rather than folded away: lowercasing Test-Tool and
# test_tool onto one slug made them share a launcher entry and re-extract each
# other's icon on every sync.
id_for() {
  printf '%s' "$(basename "$1")" \
    | sed 's/\.[Aa]pp[Ii]mage$//' \
    | tr -c 'A-Za-z0-9._-' '-' \
    | sed 's/-\{2,\}/-/g; s/^[-.]*//; s/-*$//'
}

# Read one key out of a desktop file's [Desktop Entry] section.
entry_get() { [[ -f $1 ]] || return 0; sed -n "s/^$2=//p" "$1" | head -1; }

# Every localized variant of a key, as whole "Key[nl]=value" lines. The
# launcher searches GenericName, Comment and Keywords, so dropping their
# translations would make an app findable in English only. Reads the accepted
# copy of the entry, so what comes back is already single-line and capped.
entry_get_localized() { [[ -f $1 ]] || return 0; grep -E "^$2\[[^]]+\]=" "$1" || true; }

# The byte offset of the squashfs image inside a type-2 AppImage: an ELF
# runtime with the image appended after its section header table, or after
# its last segment when the table is missing.
#
# The header is attacker-controlled, so nothing in it is trusted before it is
# checked: class, data encoding and version must be the ones ELF defines, the
# header and entry sizes must be exactly what that class prescribes, the entry
# count is capped far above anything a real runtime carries, and every offset
# plus length is proven to lie inside the regular file before it is read.
# Reads are fixed-size and at most 4 KB each; entries are read one at a time,
# never as a table sized from the header. Python integers cannot overflow, so
# the range arithmetic is exact. The helper itself runs isolated, with a clock
# and an address-space cap, so even a bug here cannot become a memory bomb.
squashfs_offset() {
  timeout "$HEADER_SECONDS" prlimit --as="$HEADER_MEMORY" /usr/bin/python3 -I - "$1" <<'PYEOF'
import os, stat, struct, sys

# Real runtimes carry about ten program headers and a few dozen sections.
MAX_PHNUM = 64
MAX_SHNUM = 4096
MAX_READ = 4096


def main(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        return 1
    size = st.st_size

    def read_at(off, n):
        if off < 0 or n < 0 or n > MAX_READ or off + n > size:
            raise ValueError("range outside file")
        os.lseek(fd, off, os.SEEK_SET)
        b = os.read(fd, n)
        if len(b) != n:
            raise ValueError("short read")
        return b

    e = read_at(0, 64)
    if e[:4] != b"\x7fELF":
        return 1
    cls, data, ident_version = e[4], e[5], e[6]
    if cls not in (1, 2) or data not in (1, 2) or ident_version != 1:
        return 1
    end = "<" if data == 1 else ">"
    (e_version,) = struct.unpack_from(end + "I", e, 0x14)
    if cls == 2:
        phoff, shoff = struct.unpack_from(end + "QQ", e, 0x20)
        ehsize, phentsize, phnum, shentsize, shnum = struct.unpack_from(end + "HHHHH", e, 0x34)
        want_ehsize, want_phentsize, want_shentsize = 64, 56, 64
    else:
        phoff, shoff = struct.unpack_from(end + "II", e, 0x1C)
        ehsize, phentsize, phnum, shentsize, shnum = struct.unpack_from(end + "HHHHH", e, 0x28)
        want_ehsize, want_phentsize, want_shentsize = 52, 32, 40
    if e_version != 1 or ehsize != want_ehsize or phentsize != want_phentsize:
        return 1
    if phnum == 0 or phnum > MAX_PHNUM:
        return 1
    if phoff < ehsize or phoff + phentsize * phnum > size:
        return 1

    image_start = 0
    if shnum:
        if shentsize != want_shentsize or shnum > MAX_SHNUM:
            return 1
        if shoff < ehsize or shoff + shentsize * shnum > size:
            return 1
        image_start = shoff + shentsize * shnum

    for i in range(phnum):
        ph = read_at(phoff + i * phentsize, phentsize)
        if cls == 2:
            p_offset, _, _, p_filesz = struct.unpack_from(end + "QQQQ", ph, 0x08)
        else:
            p_offset, _, _, p_filesz = struct.unpack_from(end + "IIII", ph, 0x04)
        if p_offset + p_filesz > size:
            return 1
        image_start = max(image_start, p_offset + p_filesz)

    # A squashfs superblock is 96 bytes and says which version it is. Only a
    # 4.0 image is handed to unsquashfs; anything else is not an AppImage.
    if image_start + 96 > size:
        return 1
    sb = read_at(image_start, 96)
    if sb[:4] != b"hsqs":
        return 1
    if struct.unpack_from("<HH", sb, 28) != (4, 0):
        return 1
    print(image_start)
    return 0


try:
    sys.exit(main(sys.argv[1]))
except Exception:
    sys.exit(1)
PYEOF
}

# unsquashfs on the image, inside bubblewrap: no network, no home directory,
# the image read-only at /image, one scratch directory writable at /out, a
# fresh /tmp, and a clock and an address-space cap around the whole thing. A
# hostile image can make the parser fail or time out; it cannot run anything.
#
# Usage: sandboxed_unsquashfs FILE OFFSET OUT [unsquashfs options] -- [names]
# unsquashfs reads everything after the filesystem argument as a name to
# extract, so options and names are kept apart here.
sandboxed_unsquashfs() {
  local file="$1" offset="$2" out="$3" opts=()
  shift 3
  while (( $# )) && [[ $1 != -- ]]; do opts+=("$1"); shift; done
  [[ ${1:-} == -- ]] && shift
  timeout "$EXTRACT_SECONDS" prlimit --as=2147483648 --fsize="$MAX_ICON_BYTES" \
    bwrap --ro-bind /usr /usr --symlink usr/lib /lib --symlink usr/lib /lib64 \
      --symlink usr/bin /bin --symlink usr/bin /sbin \
      --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache \
      --proc /proc --dev /dev --tmpfs /tmp \
      --ro-bind "$file" /image --bind "$out" /out \
      --unshare-all --die-with-parent --new-session --clearenv --chdir /tmp \
      -- unsquashfs -o "$offset" -d /out/x -no-xattrs -no-progress -quiet -p 1 \
           -ignore-errors -f "${opts[@]}" /image "$@" 2>/dev/null
}

# A path inside the image we are willing to ask for by name: relative, plain
# characters, no ".." component, bounded length.
image_path_ok() {
  local p="$1"
  [[ ${#p} -le 255 && $p =~ ^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$ && $p != *..* ]]
}

# Copies what we use from an untrusted desktop file and nothing else: the
# [Desktop Entry] group only, a known set of keys, one line each, control
# characters removed, each value capped. Exec never survives this -- the
# launcher entry gets an Exec we write ourselves -- and neither do actions,
# so nothing an image says can end up being run on its behalf.
accept_entry() {
  awk '
    BEGIN {
      cap["Name"] = 128; cap["GenericName"] = 128; cap["Comment"] = 256
      cap["Keywords"] = 512; cap["Categories"] = 256; cap["MimeType"] = 512
      cap["StartupWMClass"] = 128; cap["Icon"] = 64; cap["X-AppImage-Version"] = 32
      print "[Desktop Entry]"
    }
    NR > 400 { exit }
    /^\[/ { inside = ($0 == "[Desktop Entry]"); next }
    !inside { next }
    match($0, /^([A-Za-z-]+)(\[[A-Za-z0-9_@.-]{1,24}\])?=/) {
      key = $0; sub(/[\[=].*$/, "", key)
      if (!(key in cap)) next
      locale = substr($0, length(key) + 1, RLENGTH - length(key) - 1)
      value = substr($0, RLENGTH + 1)
      gsub(/[\001-\037\177]/, "", value)
      if (key == "Icon") { if (locale != "" || value !~ /^[A-Za-z0-9._-]+$/) next }
      value = substr(value, 1, cap[key])
      if (value == "") next
      print key locale "=" value
    }
  ' "$1"
}

# An older layout kept overrides at the top level, keyed by id. Fold those into
# .apps so a config written before this version keeps working.
migrate_config() {
  [[ -s $CONFIG ]] || return 0
  jq -e 'has("apps") or has("directory")' "$CONFIG" >/dev/null 2>&1 && return 0
  local tmp
  tmp=$(mktemp)
  jq '{apps: .}' "$CONFIG" >"$tmp" && mv "$tmp" "$CONFIG"
}

appimage_dir() {
  local dir=""
  [[ -s $CONFIG ]] && dir=$(jq -r '.directory // ""' "$CONFIG" 2>/dev/null)
  [[ -n $dir ]] || dir="${APPIMAGE_DIR:-$HOME/AppImage}"
  printf '%s' "${dir/#\~/$HOME}"
}

override() {
  [[ -f $CONFIG ]] || return 0
  jq -r --arg id "$1" --arg key "$2" '(.apps[$id][$key] // "") | tostring' "$CONFIG" 2>/dev/null | grep -v '^null$' || true
}

config_set() {
  local id="$1" key="$2" value="$3" tmp
  mkdir -p "$(dirname "$CONFIG")"
  [[ -s $CONFIG ]] || echo '{}' >"$CONFIG"
  migrate_config
  tmp=$(mktemp)
  if [[ -n $value ]]; then
    jq --arg id "$id" --arg key "$key" --arg value "$value" '.apps[$id][$key] = $value' "$CONFIG" >"$tmp"
  else
    jq --arg id "$id" --arg key "$key" '
      del(.apps[$id][$key])
      | if (.apps[$id] | length) == 0 then del(.apps[$id]) else . end
    ' "$CONFIG" >"$tmp"
  fi
  mv "$tmp" "$CONFIG"
}

appimage_files() {
  find "$(appimage_dir)" -maxdepth 1 -type f -iname '*.appimage' -print0 2>/dev/null | sort -z
}

# Read the desktop entry and icon out of an AppImage into its state directory
# without executing it. The fingerprint is recorded whatever happens, so an
# image that cannot be read is looked at once, not on every sync.
harvest() {
  local file="$1" id="$2" state="$STATE_DIR/$id" fingerprint offset out listing entry src icon target

  fingerprint=$(stat -c '%s %Y' "$file")
  [[ $(cat "$state/fingerprint" 2>/dev/null) == "$fingerprint" ]] && return 0

  rm -rf "$state"
  mkdir -p "$state"
  echo "$fingerprint" >"$state/fingerprint"

  if ! command -v unsquashfs >/dev/null || ! command -v bwrap >/dev/null || [[ ! -x /usr/bin/python3 ]]; then
    echo "no-tools" >"$state/status"
    return 0
  fi
  if ! offset=$(squashfs_offset "$file"); then
    echo "no-image" >"$state/status"
    return 0
  fi

  out=$(mktemp -d)

  # First a listing of the image root, capped in lines and line length, and
  # from it two names: the entry, and what .DirIcon is or points at. Every
  # extraction after this asks for one exact path, wildcards off, so at most
  # three files ever come out of an image, each under the per-file size cap --
  # a root directory of a million entries cannot fill the disk.
  listing=$(sandboxed_unsquashfs "$file" "$offset" "$out" -lls -max-depth 1 -- | head -n 4000 | cut -c1-512 || true)
  entry=$(printf '%s\n' "$listing" | awk -v max="$MAX_ENTRY_BYTES" \
    '$1 ~ /^-/ && $6 ~ /^\/out\/x\/[A-Za-z0-9._-]+\.desktop$/ && $3 + 0 <= max { sub(/^\/out\/x\//, "", $6); print $6; exit }')
  target=$(printf '%s\n' "$listing" | awk \
    '$6 == "/out/x/.DirIcon" { if ($1 ~ /^l/ && $7 == "->") print $8; else if ($1 ~ /^-/) print ".DirIcon"; exit }')

  if [[ -n $entry ]]; then
    sandboxed_unsquashfs "$file" "$offset" "$out" -no-wildcards -- "$entry" >/dev/null || true
    src="$out/x/$entry"
    if [[ -f $src && ! -L $src ]] && (( $(stat -c '%s' "$src") <= MAX_ENTRY_BYTES )); then
      accept_entry "$src" >"$state/entry.desktop"
    fi
  fi

  # .DirIcon is the AppImage's own icon, usually a symlink into the image. The
  # listing told us where it points; that path is fetched by exact name, so a
  # link can only ever resolve to something inside the image.
  icon=""
  target=${target#/}
  if [[ -n $target ]] && image_path_ok "$target"; then
    sandboxed_unsquashfs "$file" "$offset" "$out" -no-wildcards -- "$target" >/dev/null || true
    [[ -f "$out/x/$target" && ! -L "$out/x/$target" ]] && icon="$out/x/$target"
  fi
  if [[ -z $icon ]]; then
    # Second chance: the icon named by the entry, at the image root as the
    # AppImage spec requires. The name was validated to a plain filename.
    target=$(entry_get "$state/entry.desktop" Icon)
    if [[ -n $target ]] && image_path_ok "$target"; then
      sandboxed_unsquashfs "$file" "$offset" "$out" -no-wildcards -- "$target.png" "$target.svg" "$target.xpm" >/dev/null || true
      for ext in png svg xpm; do
        [[ -f "$out/x/$target.$ext" && ! -L "$out/x/$target.$ext" ]] && { icon="$out/x/$target.$ext"; break; }
      done
    fi
  fi
  [[ -n $icon && -f $icon ]] && accept_icon "$icon" "$state"

  rm -rf "$out"
  if [[ -s $state/entry.desktop ]]; then echo "ok" >"$state/status"; else echo "no-entry" >"$state/status"; fi
}

# An icon is kept only when it is small enough and starts like a PNG, SVG or
# XPM; anything else is left behind and the entry gets the generic icon.
accept_icon() {
  local src="$1" state="$2" magic head ext
  (( $(stat -c '%s' "$src") <= MAX_ICON_BYTES )) || return 0
  magic=$(head -c 8 "$src" | od -An -tx1 | tr -d ' \n')
  head=$(head -c 256 "$src" | tr -d '\000' | tr -cd '[:print:]')
  if [[ $magic == 89504e470d0a1a0a ]]; then ext=png
  elif [[ $head == *"<svg"* || $head == *"<?xml"* ]]; then ext=svg
  elif [[ $head == *"XPM"* ]]; then ext=xpm
  else return 0
  fi
  cp "$src" "$state/icon.$ext"
}

# Prints nothing and still succeeds when an AppImage carries no icon; a
# non-zero return here would take every caller down with it under set -e.
icon_path() {
  local candidate
  for candidate in "$STATE_DIR/$1"/icon.*; do
    [[ -f $candidate ]] && { printf '%s' "$candidate"; return 0; }
  done
  return 0
}

embedded_name() {
  local name
  name=$(entry_get "$STATE_DIR/$1/entry.desktop" Name)
  [[ -n $name ]] || name=$(titleize "$(basename "$2" | sed 's/\.[Aa]pp[Ii]mage$//')")
  printf '%s' "$name"
}

display_name() {
  local name
  name=$(override "$1" name)
  [[ -n $name ]] || name=$(embedded_name "$1" "$2")
  printf '%s' "$name"
}

write_desktop() {
  local file="$1" id="$2" src="$STATE_DIR/$id/entry.desktop"
  local out="$DESKTOP_DIR/$PREFIX$id.desktop"
  local name generic comment categories mime wmclass icon args keywords version

  name=$(display_name "$id" "$file")
  generic=$(entry_get "$src" GenericName)
  comment=$(entry_get "$src" Comment)
  keywords=$(entry_get "$src" Keywords)
  categories=$(clean_line "$(override "$id" categories)" 256)
  [[ -n $categories ]] || categories=$(entry_get "$src" Categories)
  [[ -n $categories ]] || categories="Utility;"
  mime=$(entry_get "$src" MimeType)
  wmclass=$(entry_get "$src" StartupWMClass)
  version=$(entry_get "$src" X-AppImage-Version)
  # The only arguments that reach Exec are the user's own, from the config.
  args=$(clean_line "$(override "$id" args)" 256)
  icon=$(icon_path "$id")
  [[ -n $icon ]] || icon="application-x-executable"

  {
    echo "[Desktop Entry]"
    echo "Version=1.0"
    echo "Type=Application"
    echo "Name=$name"
    [[ -n $generic ]] && echo "GenericName=$generic"
    [[ -n $comment ]] && echo "Comment=$comment"
    # Keywords, GenericName and Comment are all searched by the Omarchy
    # launcher, so their translations come along too. Name deliberately does
    # not: a rename would otherwise still show the old name under a locale.
    entry_get_localized "$src" GenericName
    entry_get_localized "$src" Comment
    entry_get_localized "$src" Keywords
    [[ -n $keywords ]] && echo "Keywords=$keywords"
    echo "Exec=\"$file\"${args:+ $args} %U"
    echo "TryExec=$file"
    echo "Icon=$icon"
    echo "Terminal=false"
    echo "StartupNotify=true"
    [[ -n $wmclass ]] && echo "StartupWMClass=$wmclass"
    echo "Categories=$categories"
    [[ -n $mime ]] && echo "MimeType=$mime"
    [[ $(override "$id" hidden) == true ]] && echo "NoDisplay=true"
    echo "X-AppImage-File=$file"
    [[ -n $version ]] && echo "X-AppImage-Version=$version"
    # The block's status is the function's; an optional last line must not
    # turn a fully written entry into a "skipped" one.
    :
  } >"$out"
}

# One line, no control characters, at most $2 characters.
clean_line() {
  printf '%s' "$1" | head -1 | tr -d '\000-\037\177' | cut -c1-"$2"
}

# Drop every entry this sync did not just write, and the cache behind it.
# Keying on "was it written" rather than "does the file still exist" is what
# makes a renamed AppImage, or an id that changed shape between versions, leave
# one entry behind instead of two pointing at the same file.
prune() {
  local written="$1" entry id
  for entry in "$DESKTOP_DIR/$PREFIX"*.desktop; do
    [[ -e $entry ]] || continue
    id=$(basename "$entry" .desktop | sed "s/^$PREFIX//")
    [[ $'\n'$written$'\n' == *$'\n'$id$'\n'* ]] && continue
    rm -f "$entry"
    rm -rf "${STATE_DIR:?}/$id"
  done
}

# Two filenames can still meet on one id once unusual characters fold to a
# dash ("a b.AppImage" and "a-b.AppImage"). Whoever sorts first keeps the plain
# id; the rest are numbered, so the pair is at least never one entry.
unique_id() {
  local base="$1" taken="$2"
  local candidate="$base" n=1
  while [[ $'\n'$taken$'\n' == *$'\n'$candidate$'\n'* ]]; do
    n=$((n + 1))
    candidate="$base-$n"
  done
  printf '%s' "$candidate"
}

file_for_id() {
  local file id seen=""
  while IFS= read -r -d '' file; do
    id=$(unique_id "$(id_for "$file")" "$seen")
    seen+=$'\n'"$id"
    [[ $id == "$1" ]] && { printf '%s' "$file"; return 0; }
  done < <(appimage_files)
  return 1
}

cmd_sync() {
  local quiet=0 count=0 file id seen=""
  [[ ${1:-} == --quiet ]] && quiet=1
  mkdir -p "$DESKTOP_DIR" "$STATE_DIR" "$(appimage_dir)"

  while IFS= read -r -d '' file; do
    [[ -x $file ]] || chmod +x "$file"
    id=$(unique_id "$(id_for "$file")" "$seen")
    [[ -n $id ]] || continue
    # Recorded before the write, so one AppImage that fails to unpack cannot
    # make prune throw away the entry it already had.
    seen+=$'\n'"$id"
    if harvest "$file" "$id" && write_desktop "$file" "$id"; then
      ((count++)) || true
    else
      echo "appimages: skipped $file" >&2
    fi
  done < <(appimage_files)

  prune "$seen"
  command -v update-desktop-database >/dev/null && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  (( quiet )) || notify "AppImages synced" "$count in $(basename "$(appimage_dir)")"
}

# TSV for the panel: id, name, file, icon, size, whether the name is a user
# override, embedded version, window class, hidden, and whether a window of it
# is open. Tabs cannot appear in any field, so no quoting is needed.
cmd_list() {
  local file id name icon custom version wmclass hidden running classes seen=""

  # One hyprctl call for the whole list rather than one per row.
  classes=$(hyprctl clients -j 2>/dev/null | jq -r '.[].class // empty' | tr '[:upper:]' '[:lower:]' || true)

  while IFS= read -r -d '' file; do
    id=$(unique_id "$(id_for "$file")" "$seen")
    [[ -n $id ]] || continue
    seen+=$'\n'"$id"
    name=$(display_name "$id" "$file")
    icon=$(icon_path "$id")
    version=$(entry_get "$STATE_DIR/$id/entry.desktop" X-AppImage-Version)
    wmclass=$(entry_get "$STATE_DIR/$id/entry.desktop" StartupWMClass)
    custom=0
    [[ -n $(override "$id" name) ]] && custom=1
    hidden=0
    [[ $(override "$id" hidden) == true ]] && hidden=1
    # Only an AppImage that declares a window class can be matched to a window;
    # guessing from the name would light up the wrong row.
    running=0
    if [[ -n $wmclass ]] && grep -qxF "$(printf '%s' "$wmclass" | tr '[:upper:]' '[:lower:]')" <<<"$classes"; then
      running=1
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$id" "$name" "$file" "$icon" "$(stat -c '%s' "$file")" "$custom" \
      "$version" "$wmclass" "$hidden" "$running"
  done < <(appimage_files)
}

cmd_rename() {
  local id="${1:-}" name="${2-}" options=() selection base current="" file=""
  declare -A by_base file_by_id

  while IFS=$'\t' read -r row_id row_name row_file _; do
    base=$(basename "$row_file")
    by_base["$base"]="$row_id"
    file_by_id["$row_id"]="$row_file"
    [[ $id == "$row_id" ]] && { current="$row_name"; file="$row_file"; }
    options+=("$GLYPH"$'\t'"$row_name"$'\t'"$base")
  done < <(cmd_list)

  if (( ${#options[@]} == 0 )); then
    notify "No AppImages found" "$(appimage_dir) is empty"
    exit 0
  fi

  if [[ -z $id ]]; then
    selection=$(omarchy-menu-select "Rename AppImage" "${options[@]}") || exit 0
    current=${selection%%$'\t'*}
    base=${selection##*$'\t'}
    id="${by_base[$base]:-}"
    file="${file_by_id[$id]:-}"
  fi
  [[ -n $id ]] || exit 0

  # Two arguments means the panel already collected the name; one means we
  # still have to ask for it.
  if (( $# < 2 )); then
    name=$(omarchy-menu-input "Launcher name (empty resets to \"$(embedded_name "$id" "$file")\")") || exit 0
  fi

  config_set "$id" name "$name"
  cmd_sync --quiet
  notify "Renamed" "$(display_name "$id" "$file")"
}

# Hidden keeps the AppImage and its cached icon, and only writes NoDisplay so
# the launcher stops offering it. With no second argument it toggles.
cmd_hide() {
  local id="${1:-}" want="${2-}"
  [[ -n $id ]] || { echo "appimages: hide needs an id" >&2; exit 1; }
  if [[ -z $want ]]; then
    if [[ $(override "$id" hidden) == true ]]; then want="off"; else want="on"; fi
  fi
  case "$want" in
    on|true|1|yes) config_set "$id" hidden "true" ;;
    *) config_set "$id" hidden "" ;;
  esac
  cmd_sync --quiet
}

# Deletes the AppImage itself. The launcher entry and the cached icon follow
# from the sync, the same way they would if the file were removed by hand.
cmd_delete() {
  local id="${1:-}" file
  file=$(file_for_id "$id") || { echo "appimages: no such AppImage: $id" >&2; exit 1; }
  rm -f -- "$file"
  cmd_sync --quiet
  notify "Deleted" "$(basename "$file")"
}

# setsid detaches the app from this script and from whatever called it, so it
# survives an omarchy-shell restart. A non-zero exit within a few seconds is a
# failure to start -- a missing FUSE, a broken image -- which would otherwise
# vanish without a word; a non-zero exit later is just how the user quit.
cmd_run() {
  local id="${1:-}" file name log
  file=$(file_for_id "$id") || { echo "appimages: no such AppImage: $id" >&2; exit 1; }
  name=$(display_name "$id" "$file")
  log=$(mktemp)
  setsid -f bash -c '
    file="$1"; log="$2"; name="$3"; glyph="$4"
    start=$(date +%s)
    "$file" >"$log" 2>&1
    code=$?
    if (( code != 0 && $(date +%s) - start < 5 )); then
      omarchy-notification-send -u critical -g "$glyph" "$name did not start" "$(tail -n 1 "$log")"
    fi
    rm -f "$log"
  ' _ "$file" "$log" "$name" "$GLYPH" >/dev/null 2>&1
}

cmd_focus() {
  local id="${1:-}" file wmclass
  file=$(file_for_id "$id") || { echo "appimages: no such AppImage: $id" >&2; exit 1; }
  wmclass=$(entry_get "$STATE_DIR/$id/entry.desktop" StartupWMClass)
  [[ -n $wmclass ]] || wmclass=$(display_name "$id" "$file")
  omarchy-hyprland-focus-app "$wmclass"
}

cmd_menu() {
  local choice
  choice=$(omarchy-menu-select "AppImages" \
    $'󰑐\t'"Sync now" \
    $'󰑕\t'"Rename" \
    $'󰉋\t'"Open folder") || exit 0
  case "$choice" in
    "Sync now") cmd_sync ;;
    "Rename") cmd_rename ;;
    "Open folder") uwsm-app -- xdg-open "$(appimage_dir)" >/dev/null 2>&1 & ;;
  esac
}

# Every entry point reads overrides, so fold an older config into the current
# shape once, up front, rather than in whichever command happens to write next.
migrate_config

case "${1:-sync}" in
  sync) shift || true; cmd_sync "$@" ;;
  list) cmd_list ;;
  dir) appimage_dir; echo ;;
  rename) shift; cmd_rename "$@" ;;
  hide) shift; cmd_hide "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  run) shift; cmd_run "$@" ;;
  focus) shift; cmd_focus "$@" ;;
  menu) cmd_menu ;;
  *)
    echo "Usage: appimages [sync [--quiet] | list | dir | rename [id] [name]" >&2
    echo "                 | hide <id> [on|off] | run <id> | focus <id> | delete <id> | menu]" >&2
    exit 1
    ;;
esac
